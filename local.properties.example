# Copiá este archivo como local.properties (NO se versiona) y completá tus valores.
# Ruta del Android SDK (Android Studio la completa sola).
sdk.dir=
# Una o varias claves de NVIDIA NIM (https://build.nvidia.com) separadas por coma, en el orden en que se prueban.
# Opcional: también se cargan desde Ajustes. Se sigue aceptando NVIDIA_API_KEY (una sola).
NVIDIA_API_KEYS=
# Una o varias claves de Gemini separadas por coma. Opcional: también se cargan desde Ajustes.
GEMINI_API_KEYS=
